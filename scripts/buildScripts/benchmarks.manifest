# ---- PolyBench/GPU ----------------------------------------------------------
# Each kernel is single-TU: one .cu, no argv (sizes are compile-time #defines),
# no data files. inc='-' because the kernel's #include "../../common/..." paths
# are relative to the source file and clang resolves them automatically.
# DEFAULT DATA_TYPE IS FLOAT — flip to double in each .cuh for FP64 coverage.
# Build through run_single_tu.sh on ONE kernel (gemm) first: the textual
# include of ../../common/polybench.c + driver-API cuda.h may need a small tweak.
gemm        | polybench | tests/benchmarks/polybench/CUDA/GEMM/gemm.cu            | - | - | -
gramschmidt | polybench | tests/benchmarks/polybench/CUDA/GRAMSCHM/gramschmidt.cu | - | - | -
2mm         | polybench | tests/benchmarks/polybench/CUDA/2MM/2mm.cu              | - | - | -
3mm         | polybench | tests/benchmarks/polybench/CUDA/3MM/3mm.cu              | - | - | -
fdtd2d      | polybench | tests/benchmarks/polybench/CUDA/FDTD-2D/fdtd2d.cu       | - | - | -
correlation | polybench | tests/benchmarks/polybench/CUDA/CORR/correlation.cu     | - | - | -
covariance  | polybench | tests/benchmarks/polybench/CUDA/COVAR/covariance.cu     | - | - | -
syrk        | polybench | tests/benchmarks/polybench/CUDA/SYRK/syrk.cu            | - | - | -
syr2k       | polybench | tests/benchmarks/polybench/CUDA/SYR2K/syr2k.cu          | - | - | -
gesummv     | polybench | tests/benchmarks/polybench/CUDA/GESUMMV/gesummv.cu      | - | - | -
mvt         | polybench | tests/benchmarks/polybench/CUDA/MVT/mvt.cu              | - | - | -
atax        | polybench | tests/benchmarks/polybench/CUDA/ATAX/atax.cu            | - | - | -
bicg        | polybench | tests/benchmarks/polybench/CUDA/BICG/bicg.cu            | - | - | -
