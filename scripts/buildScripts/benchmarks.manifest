# PaeFEx single-TU benchmark manifest
# Pipe-delimited. '#' = comment, blank lines ignored. '-' = empty field.
# Fields:  name | group | src | inc | args | expect
#   name   : unique key (also the scratch/results subdir; may contain no spaces)
#   group  : basic | micro | rodinia | shoc | ecp | parboil  (drives run order)
#   src    : .cu to compile (the single TU; #includes pull in the rest)
#   inc    : one include dir, or '-' for none
#   args   : runtime argv (space-separated, passed through verbatim), or '-'
#   expect : for basics only — the ONE exception class the test must fire
#            (invalid|divzero|overflow|underflow); '-' for everything else.
#            NOTE: subnormal is not a class here; it is the allowed companion
#            of underflow and is never counted as a cross-class leak.
#
# Run order (item 5): micro + basic first (fast validation), then rodinia, then
# the rest. The harness can sort by group; within a group, file order is fine.

# ---------- micro ----------
contention_stress | micro | tests/contention_stress.cu | tests | - | -
# TODO confirm paths/args for the other micros:
# gpu_fpx   | micro | tests/gpu_fpx.cu        | tests | - | -
# libdevice | micro | TODO/libdevice.cu       | -     | - | -

# ---------- basic_tests (ground truth: each fires exactly its named class) ----------
divByZero      | basic | tests/basic_tests/divZero/divByZero.cu       | - | - | divzero
logB_test      | basic | tests/basic_tests/divZero/logB_test.cu       | - | - | divzero
inv_div        | basic | tests/basic_tests/invalid/div.cu             | - | - | invalid
fma_zero_inf   | basic | tests/basic_tests/invalid/fma_zero_inf.cu    | - | - | invalid
inf_sub        | basic | tests/basic_tests/invalid/inf_sub.cu         | - | - | invalid
mul_zero_inf   | basic | tests/basic_tests/invalid/mul_zero_inf.cu    | - | - | invalid
sqrt_invalid   | basic | tests/basic_tests/invalid/sqrt.cu            | - | - | invalid
round_nearest  | basic | tests/basic_tests/overflow/round_nearest.cu  | - | - | overflow
round_negative | basic | tests/basic_tests/overflow/round_negative.cu | - | - | overflow
round_positive | basic | tests/basic_tests/overflow/round_positive.cu | - | - | overflow
round_zero     | basic | tests/basic_tests/overflow/round_zero.cu     | - | - | overflow
uf_basic       | basic | tests/basic_tests/underflow/basic.cu         | - | - | underflow
uf_denormal    | basic | tests/basic_tests/underflow/denormal.cu      | - | - | underflow
uf_gradual     | basic | tests/basic_tests/underflow/gradual.cu       | - | - | underflow
uf_iterative   | basic | tests/basic_tests/underflow/iterative.cu     | - | - | underflow
uf_rounding    | basic | tests/basic_tests/underflow/rounding.cu      | - | - | underflow

